			"$if": "productType === 0x0102",
			"label": "Temperature Reports: Lower Limit",
			"description": "Devices in Group 3 will receive a Basic Set command if the temperature drops below this value.",
			"valueSize": 2,
			"unit": "0.1 (°C/°F)",
